# Local credentials and provider configuration
.env
.env.*
!.env.example
.modal.toml

# Local environments, editor metadata and operating-system files
venv/
.venv/
.venv-modal/
.vscode/
.DS_Store

# Re-creatable Python/tool caches, logs and build output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
*.log
*.bak
build/
dist/
*.egg-info/

# Persistent application data: ignored does NOT mean disposable.
# Seed JSON and packaged resources/word banks remain tracked.
# Existing tracked avatars remain tracked; new uploads stay local.
/data/avatars/*
!/data/avatars/.gitkeep
/data/previews/*.json
/data/previews/*.sqlite3*
/data/generated_images/*
!/data/generated_images/.gitkeep
/data/generated_audio/*
!/data/generated_audio/.gitkeep
/data/generated_narration/
/data/generated_video/

# Local experiments: inspect paid-attempt markers/recovery state before cleanup.
/data/tts-comparison/
/data/jingle-reference-comparison/
/tmp/

# Local Modal/ACE-Step downloads and model/runtime caches
.modal/
/checkpoints/
/model_weights/
