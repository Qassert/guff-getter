# Copy into root .env; never commit credentials.
OPENAI_API_KEY=
MONGO_URI=

# Jingles: private Modal endpoint; server-side only. MAKE is explicit, never automatic.
MODAL_JINGLE_ENDPOINT=
MODAL_JINGLE_KEY=
MODAL_JINGLE_SECRET=
NEWSMUNCHER_JINGLE_BRIEF_MODEL=gpt-4.1-mini
# Server-side UTC daily NEW CLAIM cap; failures count, playback never counts.
NEWSMUNCHER_JINGLE_DAILY_LIMIT=20

NEWSMUNCHER_JINGLE_ENABLED=true
# Deployment-only; L4 is the first successfully benchmarked GPU.
NEWSMUNCHER_JINGLE_GPU=L4
